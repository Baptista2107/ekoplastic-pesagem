#!/bin/bash
# PORTAO DE TESTES do push (22/10/2026) — o mesmo da FASE 1 do ENVIAR-ATUALIZACAO.bat,
# para o caminho que virou padrao em 17/10: editar na VPS -> push -> ssh minipc POST
# /sistema/atualizar. O Mini PC so puxa o origin/main; se o push nao passa sem teste,
# o Mini PC nunca recebe codigo que nao passou.
#
# Testa o COMMIT que vai subir (worktree temporaria), nao a pasta de trabalho: arquivo
# sujo nao aprova nem reprova o push. Teto: 15 min.
# Ativo no clone por:  git config core.hooksPath tools/hooks
# Pular: nao ha chave desde 22/10 (padrao para qualquer pessoa; a trava do Claude
# Code desta conta recusa --no-verify). Teste errado se conserta no teste.
#
# JA APROVADO (16/11/2026): se a suite inteira ja passou nesta mesma ARVORE (mesmo
# conteudo de arquivos, mesmo node, mesmo package-lock) nas ultimas 24 h, nao roda
# de novo e diz isso numa linha. A marca so e gravada pelo rodar-todos.js 100%
# verde AQUI, na pasta temporaria do commit (EKO_APROVADOS_GRAVAR), nunca no
# clone — ver testes/_aprovados.js. Commit sem esse arquivo (anterior a 16/11)
# sempre roda.
set -u
raiz=$(git rev-parse --show-toplevel)
# Push saindo de um worktree ligado: o git exporta GIT_DIR=<repo>/.git/worktrees/<wt>
# para este hook, e a suite herdava -> teste que roda git (commit-atual.js) commitava
# no ramo de verdade (24/11/2026: 3 commits vazios "a"/"v1"/"v2" no
# bobina-alta-densidade). Daqui para baixo o git acha o repo pelo -C/cwd.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY GIT_PREFIX
zeros=0000000000000000000000000000000000000000
while read -r _lref lsha _rref _rsha; do
    [ "$lsha" = "$zeros" ] && continue          # apagando ramo remoto: nada a testar
    tmp=$(mktemp -d)
    trap 'git -C "$raiz" worktree remove --force "$tmp" >/dev/null 2>&1; rm -rf "$tmp"' EXIT
    git -C "$raiz" worktree add --detach -q "$tmp" "$lsha" || exit 1
    if [ -f "$tmp/testes/_aprovados.js" ] && \
       (cd "$tmp" && timeout 60 node testes/_aprovados.js ja-aprovado "$lsha" </dev/null); then
        git -C "$raiz" worktree remove --force "$tmp" >/dev/null 2>&1; rm -rf "$tmp"
        trap - EXIT
        continue
    fi
    echo "[pre-push] testando ${lsha:0:7} (node testes/rodar-todos.js, teto 15 min)..."
    # </dev/null: teste nenhum pode comer a lista de refs que o while le no stdin
    saida=$(cd "$tmp" && EKO_APROVADOS_GRAVAR="$lsha" timeout 900 node testes/rodar-todos.js 2>&1 </dev/null); rc=$?
    echo "$saida" | tail -6
    if [ $rc -ne 0 ]; then
        echo "$saida" | grep -F '✗' | head -20
        echo "[pre-push] push RECUSADO: testes falharam em ${lsha:0:7} (rc=$rc)."
        echo "           Corrija e commite de novo. O Mini PC so recebe o que passou."
        exit 1
    fi
    git -C "$raiz" worktree remove --force "$tmp" >/dev/null 2>&1; rm -rf "$tmp"
    trap - EXIT
done
exit 0
